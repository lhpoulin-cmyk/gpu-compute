+func TestGenerateHandlerRepeatLimitTerminalization(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		t.Run(fmt.Sprintf("stream=%t", stream), func(t *testing.T) {
+			mock := mockRunner{
+				CompletionFn: func(_ context.Context, _ llm.CompletionRequest, fn func(llm.CompletionResponse)) error {
+					fn(llm.CompletionResponse{Content: "partial"})
+					fn(llm.CompletionResponse{Done: true, DoneReason: llm.DoneReasonRepeatLimit})
+					return nil
+				},
+			}
+			s := newServerWithMockRunner(t, &mock)
+			createMinimalGGUFModel(t, s, "repeat-limit", nil, "", nil)
+
+			w := createRequest(t, s.GenerateHandler, api.GenerateRequest{
+				Model:  "repeat-limit",
+				Prompt: "test prompt",
+				Raw:    true,
+				Stream: &stream,
+			})
+			if w.Code != http.StatusOK {
+				t.Fatalf("expected status 200, got %d: %s", w.Code, w.Body.String())
+			}
+
+			var responses []api.GenerateResponse
+			decoder := json.NewDecoder(w.Body)
+			for {
+				var response api.GenerateResponse
+				err := decoder.Decode(&response)
+				if errors.Is(err, io.EOF) {
+					break
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				responses = append(responses, response)
+			}
+
+			if stream {
+				if len(responses) != 2 {
+					t.Fatalf("got %d streaming responses, want content plus terminal", len(responses))
+				}
+				if responses[0].Response != "partial" || responses[0].Done {
+					t.Fatalf("streaming content response = %#v", responses[0])
+				}
+			} else {
+				if len(responses) != 1 {
+					t.Fatalf("got %d non-streaming responses, want one", len(responses))
+				}
+				if responses[0].Response != "partial" {
+					t.Fatalf("non-streaming response content = %q, want partial", responses[0].Response)
+				}
+			}
+
+			terminal := responses[len(responses)-1]
+			if !terminal.Done || terminal.DoneReason != "repeat_limit" {
+				t.Fatalf("terminal response = %#v", terminal)
+			}
+		})
+	}
+}
