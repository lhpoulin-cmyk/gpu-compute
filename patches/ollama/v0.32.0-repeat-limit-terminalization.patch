+func TestLlamaServerCompletionCancellationRemainsAnError(t *testing.T) {
+	release := make(chan struct{})
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/health" {
+			fmt.Fprint(w, `{"status":"ok"}`)
+			return
+		}
+		if r.URL.Path != "/completion" {
+			t.Errorf("unexpected path: %s", r.URL.Path)
+			return
+		}
+
+		w.Header().Set("Content-Type", "text/event-stream")
+		flusher, ok := w.(http.Flusher)
+		if !ok {
+			t.Fatal("test server cannot flush")
+		}
+		fmt.Fprintln(w, `data: {"content":"first","stop":false}`)
+		flusher.Flush()
+		<-release
+		fmt.Fprintln(w, `data: {"content":"second","stop":false}`)
+		flusher.Flush()
+	}))
+	defer srv.Close()
+
+	parts := strings.Split(srv.URL, ":")
+	var port int
+	fmt.Sscanf(parts[len(parts)-1], "%d", &port)
+	runner := &llamaServerRunner{
+		port:    port,
+		cmd:     fakeRunningCmd(),
+		sem:     semaphore.NewWeighted(1),
+		options: api.Options{Runner: api.Runner{NumCtx: 2048}},
+	}
+
+	ctx, cancel := context.WithCancel(t.Context())
+	opts := api.DefaultOptions()
+	err := runner.Completion(ctx, CompletionRequest{
+		Prompt:  "test prompt",
+		Options: &opts,
+	}, func(cr CompletionResponse) {
+		if cr.Content == "first" {
+			cancel()
+			close(release)
+		}
+	})
+	if err == nil || (!errors.Is(err, context.Canceled) && !strings.Contains(err.Error(), context.Canceled.Error())) {
+		t.Fatalf("Completion error = %v, want context.Canceled", err)
+	}
+}
