+func TestLlamaServerCompletionRepeatLimitTerminalizes(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/health" {
+			fmt.Fprint(w, `{"status":"ok"}`)
+			return
+		}
+		if r.URL.Path != "/completion" {
+			t.Errorf("unexpected path: %s", r.URL.Path)
+			return
+		}
+
+		w.Header().Set("Content-Type", "text/event-stream")
+		for range 32 {
+			fmt.Fprintln(w, `data: {"content":"x","stop":false}`)
+		}
+	}))
+	defer srv.Close()
+
+	parts := strings.Split(srv.URL, ":")
+	var port int
+	fmt.Sscanf(parts[len(parts)-1], "%d", &port)
+	runner := &llamaServerRunner{
+		port:    port,
+		cmd:     fakeRunningCmd(),
+		sem:     semaphore.NewWeighted(1),
+		options: api.Options{Runner: api.Runner{NumCtx: 2048}},
+	}
+
+	var responses []CompletionResponse
+	opts := api.DefaultOptions()
+	err := runner.Completion(t.Context(), CompletionRequest{
+		Prompt:  "test prompt",
+		Options: &opts,
+	}, func(cr CompletionResponse) {
+		responses = append(responses, cr)
+	})
+	if err != nil {
+		t.Fatalf("Completion error: %v", err)
+	}
+
+	if len(responses) != 32 {
+		t.Fatalf("got %d callbacks, want 31 content callbacks and one terminal callback", len(responses))
+	}
+	for i, response := range responses[:len(responses)-1] {
+		if response.Content != "x" || response.Done {
+			t.Fatalf("content callback %d = %#v", i, response)
+		}
+	}
+	terminal := responses[len(responses)-1]
+	if !terminal.Done {
+		t.Fatal("repeat limit did not produce a terminal callback")
+	}
+	if terminal.DoneReason != DoneReasonRepeatLimit {
+		t.Fatalf("DoneReason = %v, want %v", terminal.DoneReason, DoneReasonRepeatLimit)
+	}
+}
