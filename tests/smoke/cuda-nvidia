#!/usr/bin/env bash
set -Eeuo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
profile="$root/config/active-hardware-profile.yaml"
[[ -r "$profile" ]] || profile="$root/config/profiles/nvidia-rtx5070ti/profile.yaml"

pyval() {
  local expr=$1
  python3 - "$profile" "$expr" <<'PY'
import sys, yaml
p, expr = sys.argv[1:]
with open(p) as f: d = yaml.safe_load(f)
v = d
for k in expr.split('.'):
    v = v[k]
print(v)
PY
}

expected_model=$(pyval device.expected_model 2>/dev/null || pyval device.observed_model)
expected_cap=$(pyval device.compute_capability 2>/dev/null || pyval device.observed_compute_capability)
expected_cuda=$(pyval cuda.pinned_version 2>/dev/null || pyval cuda.observed_version)
min_driver=$(pyval cuda.minimum_driver 2>/dev/null || true)

failures=0
check() { local label=$1; shift; "$@" >/dev/null 2>&1 && printf '[PASS] %s\n' "$label" || { printf '[FAIL] %s\n' "$label" >&2; failures=$((failures + 1)); }; }

version_ge() {
  python3 - "$1" "$2" <<'PY'
import sys
from itertools import zip_longest
def norm(s):
    out=[]
    for p in s.split('.'):
        n=''.join(c for c in p if c.isdigit())
        out.append(int(n or 0))
    return out
obs, minimum = map(norm, sys.argv[1:])
print(int(tuple(obs) >= tuple(minimum)))
sys.exit(0 if tuple(obs) >= tuple(minimum) else 1)
PY
}

echo "=== smoke/cuda-nvidia ==="

check "nvidia-smi reports expected GPU" bash -c "nvidia-smi --query-gpu=name --format=csv,noheader | grep -Fqi '$expected_model'"
check "compute capability is $expected_cap" bash -c "nvidia-smi --query-gpu=compute_cap --format=csv,noheader | grep -Fxq '$expected_cap'"
check "/dev/nvidiactl present" test -e /dev/nvidiactl
check "/dev/nvidia-uvm present" test -e /dev/nvidia-uvm
check "nvcc available" command -v nvcc
check "CUDA toolkit pinned to $expected_cuda" bash -c "nvcc --version | grep -Eq 'release ${expected_cuda//./\\.}([, ]|$)'"
check "vulkaninfo reports NVIDIA" bash -c 'vulkaninfo --summary 2>/dev/null | grep -qi nvidia'
check "libcuda loadable" python3 -c "import ctypes; ctypes.CDLL('libcuda.so.1')"
check "llama.cpp exposes CUDA device" bash -c "llama-cli --list-devices 2>&1 | grep -Eq 'CUDA0:.*5070 Ti'"

if [[ -n "$min_driver" ]]; then
  observed_driver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1 | tr -d '[:space:]')
  if version_ge "$observed_driver" "$min_driver" >/dev/null 2>&1; then
    printf '[PASS] driver >= %s (%s)\n' "$min_driver" "$observed_driver"
  else
    printf '[FAIL] driver >= %s (observed %s)\n' "$min_driver" "$observed_driver" >&2
    failures=$((failures + 1))
  fi
fi

# Compile and execute a tiny CUDA kernel. This proves nvcc + runtime + actual device execution,
# rather than relying only on nvidia-smi metadata.
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
cat > "$tmpdir/probe.cu" <<'CU'
#include <cuda_runtime.h>
#include <cstdio>
__global__ void set_value(int *p) { *p = 42; }
int main() {
  int count = 0; if (cudaGetDeviceCount(&count) != cudaSuccess || count < 1) return 2;
  cudaDeviceProp prop{}; if (cudaGetDeviceProperties(&prop, 0) != cudaSuccess) return 3;
  int *d = nullptr, h = 0; if (cudaMalloc(&d, sizeof(int)) != cudaSuccess) return 4;
  set_value<<<1,1>>>(d); if (cudaDeviceSynchronize() != cudaSuccess) return 5;
  if (cudaMemcpy(&h, d, sizeof(int), cudaMemcpyDeviceToHost) != cudaSuccess) return 6;
  cudaFree(d);
  std::printf("name=%s compute_cap=%d.%d value=%d\n", prop.name, prop.major, prop.minor, h);
  return h == 42 ? 0 : 7;
}
CU
if nvcc -O2 "$tmpdir/probe.cu" -o "$tmpdir/probe" >/dev/null 2>&1 && \
   probe_output=$($tmpdir/probe 2>&1) && grep -Fq "compute_cap=$expected_cap" <<<"$probe_output"; then
  printf '[PASS] compiled CUDA kernel executes on compute capability %s\n' "$expected_cap"
else
  printf '[FAIL] compiled CUDA kernel execution\n' >&2
  [[ -n "${probe_output:-}" ]] && printf '%s\n' "$probe_output" >&2
  failures=$((failures + 1))
fi

echo ""
echo "=== nvidia-smi summary ==="
nvidia-smi --query-gpu=name,driver_version,memory.total,compute_cap,temperature.gpu --format=csv,noheader 2>&1 || true

[[ "$failures" -eq 0 ]] || { echo "smoke/cuda-nvidia: $failures check(s) failed" >&2; exit 1; }
echo "smoke/cuda-nvidia: PASS"
